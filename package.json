{
  "name": "goattrack",
  "version": "0.1.0",
  "private": true,
  "description": "Independent farm management application for Kallanko Boerbok Stoet.",
  "engines": {
    "node": ">=20.20.0"
  },
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm test:unit",
    "test:unit": "vitest run --project unit --passWithNoTests",
    "test:integration": "vitest run --project integration --passWithNoTests",
    "test:e2e": "playwright test --pass-with-no-tests",
    "db:start": "pnpm dlx supabase start",
    "db:status": "pnpm dlx supabase status",
    "db:reset": "pnpm dlx supabase db reset",
    "db:seed": "pnpm db:reset",
    "db:types": "pnpm dlx supabase gen types typescript --local > lib/supabase/database.types.ts",
    "db:types:check": "sh scripts/check-supabase-types.sh",
    "db:rls:check": "sh scripts/check-rls.sh",
    "quality": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:unit && pnpm build"
  },
  "dependencies": {
    "@hookform/resolvers": "5.5.7",
    "@radix-ui/react-slot": "1.3.3",
    "@supabase/ssr": "0.12.4",
    "@supabase/supabase-js": "2.111.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.28.0",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.83.0",
    "recharts": "3.10.1",
    "server-only": "0.0.1",
    "tailwind-merge": "3.6.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.12",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
